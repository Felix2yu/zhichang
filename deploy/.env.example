# 复制为 .env 后填写
POSTGRES_PASSWORD=zhichang

# 数据接入令牌：Health Auto Export 的 X-Zhichang-Token 用同一个值
ZHICHANG_INGEST_TOKEN=change-me

# MCP over HTTP 的访问令牌（留空表示不校验）
ZHICHANG_MCP_TOKEN=

# 目标设置令牌：页面上改睡眠目标时要填它；留空则目标只读
ZHICHANG_SETTINGS_TOKEN=

# 无偏移记录回落的时区
ZHICHANG_HOME_TZ=Asia/Shanghai

# 宿主机目录属主（避免容器内写出 root 属主文件）
PUID=1000
PGID=1000
